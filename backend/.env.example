DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# در تولید: https://yourdomain.ir
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- پرداخت کارت‌به‌کارت ---
BILLING_CARD_NUMBER=6037-0000-0000-0000
BILLING_CARD_HOLDER=نام صاحب کارت
BILLING_BANK=نام بانک
PRICE_MONTHLY=99000
PRICE_YEARLY=790000

# --- اعلان به ادمین (اختیاری ولی بسیار توصیه می‌شود) ---
# ربات تلگرام: از BotFather توکن بگیرید و chat id خودتان یا گروه را بگذارید
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# اگر سرور به تلگرام دسترسی ندارد می‌توانید API سازگار (مثل بله) یا وب‌هوک بگذارید:
# TELEGRAM_API_BASE=https://tapi.bale.ai
NOTIFY_WEBHOOK_URL=
SITE_ADMIN_URL=http://127.0.0.1:8000/admin/
NOTIFY_ON_SIGNUP=0

# --- اعلان‌های وب برای یادآوری عادت‌ها ---
# python manage.py generate_vapid  (خروجی را اینجا بگذارید)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- عملیات ---
# REDIS_URL=redis://127.0.0.1:6379/1
# SENTRY_DSN=
# BACKUP_DIR=backups
# DB_ENGINE=postgres
# DB_NAME=plannuma
# DB_USER=plannuma
# DB_PASSWORD=
# DB_HOST=localhost
