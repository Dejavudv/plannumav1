# آدرس بک‌اند Django (سرور Next این آدرس را برای /api پروکسی می‌کند)
BACKEND_URL=http://127.0.0.1:8000
# لینک پنل ادمین (در منو فقط برای کاربران staff نمایش داده می‌شود)
NEXT_PUBLIC_ADMIN_URL=http://127.0.0.1:8000/admin/
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# منطقهٔ زمانی «امروز» (باید با TIME_ZONE بک‌اند یکی باشد)
NEXT_PUBLIC_TZ=Asia/Tehran
# راه‌های تماس (خالی = نمایش داده نمی‌شود)
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_REFUND_DAYS=7
